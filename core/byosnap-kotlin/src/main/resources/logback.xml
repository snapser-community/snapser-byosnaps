<configuration>
    <!-- Snapser reads stdout and parses each line as one JSON object. The
         SnapserJsonLayout emits {"level","message","timestamp","request-id"}
         so the Logs tool can color lines by level and correlate a request's
         log lines across snaps by request-id. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.snapser.byosnap.SnapserJsonLayout"/>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="io.ktor" level="INFO"/>
</configuration>
